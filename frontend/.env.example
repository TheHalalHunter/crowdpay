[TEMPLATE]
# Backend API base URL (used in production; Vite proxies /api in development)
# Set to the backend's public origin for production builds, for example https://api.yourcrowdpay.com
VITE_API_BASE_URL=http://localhost:3001

# Stellar network for block explorer links
VITE_STELLAR_NETWORK=testnet

# Firebase Cloud Messaging web configuration. These values identify the public
# web app; the Firebase Admin service account stays in backend/.env.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=

# Set to false to skip KYC gate in the frontend (mirrors backend KYC_REQUIRED_FOR_CAMPAIGNS)
# VITE_KYC_REQUIRED_FOR_CAMPAIGNS=false

# ── Error tracking (Sentry) ───────────────────────────────
# Get DSN from sentry.io project settings. Leave empty to disable.
VITE_SENTRY_DSN=
# Sentry org slug and project slug (for source maps upload during build)
SENTRY_ORG=
SENTRY_PROJECT=
# Sentry auth token (create at https://sentry.io/settings/account/api/auth-tokens/ — needs project:releases and org:read)
SENTRY_AUTH_TOKEN=

# ── Content Security Policy (#1070) ──────────────────────
# CSP headers are generated from the repository root:
#   npm run csp:generate
# See docs/csp-reporting.md for CSP_REPORT_URI and origin overrides.
